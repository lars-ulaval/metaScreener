OPENAI_API_KEY=

# Endpoint for the OpenAI-compatible server. Leave blank to use the public
# API at https://api.openai.com/v1.
#
# Set it to talk to a local provider instead — see the "Using local LLM
# providers" section of README.md. Any OpenAI-compatible server works:
#
#   OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama
#   OPENAI_BASE_URL=http://localhost:8080/v1      # llama.cpp
#
# A local server usually ignores the key, but the SDK still requires one to
# be present, so set OPENAI_API_KEY to any non-empty value (e.g. "ollama").
#
# This value is part of the LLM cache key. Changing it gives the new
# endpoint its own cache namespace, so switching providers re-runs rather
# than serving the previous provider's answers.
OPENAI_BASE_URL=
